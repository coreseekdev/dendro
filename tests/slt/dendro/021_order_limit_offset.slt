# ORDER BY 多列 + LIMIT/OFFSET（P2-1 续）
statement ok
CREATE TABLE ord (id BIGINT PRIMARY KEY, a TEXT, b BIGINT)

statement ok
INSERT INTO ord VALUES (1,'x',10),(2,'x',20),(3,'y',10),(4,'y',20),(5,'x',10),(6,'z',30),(7,'x',NULL)

query I
SELECT id FROM ord ORDER BY a, b, id LIMIT 3
----
1
5
2

query I
SELECT id FROM ord ORDER BY id LIMIT 0
----

query I
SELECT id FROM ord ORDER BY id LIMIT 3 OFFSET 100
----

query I
SELECT id FROM ord WHERE id > 2 ORDER BY id LIMIT 2
----
3
4
