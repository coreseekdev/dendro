# ORDER BY 多列 + LIMIT/OFFSET + DISTINCT（P2-1）
statement ok
CREATE TABLE ord (id BIGINT PRIMARY KEY, a TEXT, b BIGINT)

statement ok
INSERT INTO ord VALUES (1, 'x', 10), (2, 'x', 20), (3, 'y', 10), (4, 'y', 20), (5, 'x', 10), (6, 'z', 30), (7, 'x', NULL)

query I
SELECT id FROM ord ORDER BY a, b, id LIMIT 3
----
1
5
2

query I
SELECT id FROM ord ORDER BY b DESC, a, id LIMIT 2 OFFSET 1
----
4
2

query T
SELECT DISTINCT a FROM ord ORDER BY a
----
x
y
z

query T I
SELECT DISTINCT a, b FROM ord WHERE b IS NOT NULL ORDER BY a, b
----
x 10
x 20
y 10
y 20
z 30

query T
SELECT DISTINCT a FROM ord WHERE a != 'z' ORDER BY a LIMIT 1
----
x

query I
SELECT id FROM ord LIMIT 0
----

query I
SELECT id FROM ord ORDER BY id LIMIT 3 OFFSET 100
----
