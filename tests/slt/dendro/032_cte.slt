# CTE / WITH 非递归内联展开（P0）
# WITH c AS (SELECT ...) → FROM 中 Table{c} 替换为 Derived{c.query}
# 链式 CTE（c2 引用 c1）/ 递归拒绝 / 物化拒绝

statement ok
CREATE TABLE tt (id BIGINT PRIMARY KEY, grp TEXT, v INT)

statement ok
INSERT INTO tt VALUES (1,'a',10),(2,'a',20),(3,'b',100),(4,'b',200)

# 基础：单 CTE
query I
WITH c AS (SELECT v FROM tt) SELECT count(*) FROM c
----
4

# 带过滤的 CTE
query I
WITH c AS (SELECT v FROM tt WHERE grp = 'a') SELECT sum(v) FROM c
----
30

# 链式 CTE：c2 引用 c1
query I
WITH c1 AS (SELECT v FROM tt WHERE grp = 'a'),
     c2 AS (SELECT v * 2 AS w FROM c1)
SELECT sum(w) FROM c2
----
60

# CTE + JOIN 基表
query I
WITH big AS (SELECT id, v FROM tt WHERE v > 50)
SELECT count(*) FROM big b JOIN tt ON b.id = tt.id
----
2

# CTE 在集合操作中使用
query I
WITH ca AS (SELECT v FROM tt WHERE grp = 'a'),
     cb AS (SELECT v FROM tt WHERE grp = 'b')
SELECT count(*) FROM (SELECT v FROM ca UNION ALL SELECT v FROM cb) u
----
4

# 递归 CTE：1+2+3+4+5 = 15
query I
WITH RECURSIVE r AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM r WHERE n < 5) SELECT sum(n) FROM r
----
15

# 递归 CTE：斐波那契（行 n 的 b = fib(n)）
query I
WITH RECURSIVE fib AS (SELECT 0 AS a, 1 AS b UNION ALL SELECT b, a + b FROM fib WHERE b < 50) SELECT count(*) FROM fib
----
10

# MATERIALIZED 拒绝
statement error
WITH MATERIALIZED c AS (SELECT v FROM tt) SELECT count(*) FROM c

# 阶段3：计划路径 Cte/IterativeScan（optimize on 走 Plan::Cte delta 不动点）
query I
WITH RECURSIVE fib(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM fib WHERE n < 11) SELECT count(*) FROM fib
----
11

# join 键数值宽度归一回归：派生表 Int32 字面量 vs BIGINT 列 Int64（曾静默 0 行）
statement ok
CREATE TABLE IF NOT EXISTS jt2 (id BIGINT PRIMARY KEY)

statement ok
INSERT INTO jt2 VALUES (1),(2),(3)

query I
SELECT count(*) FROM (SELECT 1 AS n UNION ALL SELECT 2) r JOIN jt2 o ON o.id = r.n
----
2

query I
SELECT count(*) FROM jt2 o JOIN (SELECT 1 AS n UNION ALL SELECT 2) r ON o.id = r.n
----
2

# ---------- L1/L2：IN 子查询 semi-join 化 + 相关子查询迭代求值 ----------

statement ok
CREATE TABLE sj_o (id BIGINT PRIMARY KEY, cid BIGINT, total BIGINT)

statement ok
CREATE TABLE sj_c (id BIGINT PRIMARY KEY, region TEXT)

statement ok
INSERT INTO sj_o VALUES (1, 1, 100), (2, 2, 250), (3, 1, 50), (4, 3, 80), (5, NULL, 10)

statement ok
INSERT INTO sj_c VALUES (1, 'EU'), (2, 'US'), (3, 'EU')

# IN 合取项 → SemiJoin（哈希探测）
query TI rowsort
SELECT id, total FROM sj_o WHERE cid IN (SELECT id FROM sj_c WHERE region = 'EU') ORDER BY id
----
1 100
3 50
4 80

# NOT IN 反半连接
query I rowsort
SELECT id FROM sj_o WHERE cid NOT IN (SELECT id FROM sj_c WHERE region = 'EU') ORDER BY id
----
2

# probe 侧 NULL：NULL NOT IN = NULL → 弃（id 5 不出现）
query I rowsort
SELECT id FROM sj_o WHERE cid NOT IN (SELECT id FROM sj_c) ORDER BY id
----

# NOT(x IN ..) 归一反半 + 残余谓词混合（cid 全部 ∈ {1,2,3} 或
# NULL——反半连接空集；NULL 行三值逻辑亦弃）
query I rowsort
SELECT id FROM sj_o WHERE NOT (cid IN (SELECT id FROM sj_c)) AND total > 20 ORDER BY id
----

# OR 位保留 InList 内联（两种机制共存）
query I rowsort
SELECT id FROM sj_o WHERE cid IN (SELECT id FROM sj_c WHERE region = 'US') OR total > 200 ORDER BY id
----
2

# 相关 EXISTS（迭代求值 + memo）
query I rowsort
SELECT id FROM sj_o o WHERE EXISTS (SELECT 1 FROM sj_c c WHERE c.id = o.cid AND c.region = 'EU') ORDER BY id
----
1
3
4

# 相关标量子查询
query I rowsort
SELECT id FROM sj_o o WHERE o.total < (SELECT c.id * 100 FROM sj_c c WHERE c.id = o.cid) ORDER BY id
----
3
4

# 相关 IN（双层嵌套相关）
query I rowsort
SELECT id FROM sj_o o WHERE o.cid IN (SELECT c.id FROM sj_c c WHERE c.region = (SELECT x.region FROM sj_c x WHERE x.id = o.cid)) ORDER BY id
----
1
2
3
4

# CTE 引用子查询（计划期绑定可达——此前 lowering 期求值 42P01）
query I rowsort
WITH eu AS (SELECT id FROM sj_c WHERE region = 'EU') SELECT id FROM sj_o WHERE cid IN (SELECT id FROM eu) ORDER BY id
----
1
3
4

# EXPLAIN（L4 统一）：IN 子查询 → semijoin 节点入计划方言
query T
EXPLAIN SELECT id FROM sj_o WHERE cid IN (SELECT id FROM sj_c)
----
dendro.ir v1
plan @q0 {
  %t0 = table "sj_o" {cols = [id, cid, total], pk = [0]}
  %s0 = scan %t0
  %t1 = table "sj_c" {cols = [id, region], pk = [0]}
  %s1 = scan %t1
  %p0 = project %s1 {exprs = [id], names = ["id"]}
  %m0 = semijoin %s0, %p0 {negated = false, key = "cid"}
  %p1 = project %m0 {exprs = [id], names = ["id"]}
  yield %p1
}

statement ok
DROP TABLE sj_o

statement ok
DROP TABLE sj_c
