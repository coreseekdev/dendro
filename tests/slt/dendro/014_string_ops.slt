# 字符串操作（Q-1 slt 扩展）
statement ok
CREATE TABLE strs (id BIGINT PRIMARY KEY, s TEXT)

statement ok
INSERT INTO strs VALUES (1, 'hello'), (2, 'world'), (3, '')

query IT
SELECT id, upper(s) FROM strs WHERE id <= 2 ORDER BY id
----
1 HELLO
2 WORLD

query IT
SELECT id, lower(s) FROM strs WHERE id <= 2 ORDER BY id
----
1 hello
2 world

query I
SELECT length(s) FROM strs WHERE id = 1
----
5

query I
SELECT length(s) FROM strs WHERE id = 3
----
0

query I
SELECT substr(s, 1, 5) FROM strs WHERE id = 1
----
hello

query I
SELECT id FROM strs WHERE s != '' AND id = 2
----
2

query I
SELECT id FROM strs WHERE s = ''
----
3

query I
SELECT id FROM strs WHERE s != '' ORDER BY id
----
1
2
