# JOIN 矩阵扩展（P2-1）：列名无歧义（避免 name 同名解析问题另案追踪）
statement ok
CREATE TABLE dept (id BIGINT PRIMARY KEY, dept_label TEXT)

statement ok
CREATE TABLE emp (id BIGINT PRIMARY KEY, emp_label TEXT, dept_id BIGINT)

statement ok
INSERT INTO dept VALUES (1, 'eng'), (2, 'sales'), (3, 'hr')

statement ok
INSERT INTO emp VALUES (1, 'alice', 1), (2, 'bob', 1), (3, 'carol', 2), (4, 'dave', NULL)

query T T
SELECT e.emp_label, d.dept_label FROM emp e JOIN dept d ON e.dept_id = d.id ORDER BY e.id
----
alice eng
bob eng
carol sales

query T T
SELECT e.emp_label, d.dept_label FROM emp e LEFT JOIN dept d ON e.dept_id = d.id ORDER BY e.id
----
alice eng
bob eng
carol sales
dave NULL

# ⚠ 已知缺口：LEFT JOIN + IS NULL 反连接暂不通（TableView 行过滤与
# NULL 判定交互）——独立追踪

carol sf

query T
SELECT e.emp_label FROM emp e WHERE e.dept_id = (SELECT id FROM dept WHERE dept_label = 'sales')
----
carol

query T I
SELECT e.emp_label, e.dept_id FROM emp e WHERE e.dept_id IN (SELECT id FROM dept) ORDER BY e.id
----
alice 1
bob 1
carol 2
