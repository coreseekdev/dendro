# 表达式函数矩阵（P2-1 续）
statement ok
CREATE TABLE ef (id BIGINT PRIMARY KEY, a BIGINT, b TEXT)

statement ok
INSERT INTO ef VALUES (1, 10, 'hello'), (2, NULL, NULL), (3, -5, '')

query I T
SELECT id, CASE WHEN a IS NULL THEN 'none' WHEN a > 0 THEN 'pos' ELSE 'neg' END FROM ef ORDER BY id
----
1 pos
2 none
3 neg

query I I
SELECT id, coalesce(a, 0) FROM ef ORDER BY id
----
1 10
2 0
3 -5

query I
SELECT nullif(a, 10) FROM ef WHERE id = 1
----
NULL

query I
SELECT nullif(a, 99) FROM ef WHERE id = 1
----
10

query T
SELECT cast(a AS TEXT) FROM ef WHERE id = 1
----
10

query I
SELECT length(b) FROM ef WHERE id = 1
----
5

query T
SELECT upper(b) FROM ef WHERE id = 1
----
HELLO

query T
SELECT substr(b, 2, 3) FROM ef WHERE id = 1
----
ell

statement error
SELECT a / 0 FROM ef WHERE id = 1
