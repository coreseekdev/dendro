# NULL 边界（P2-1 续）：NULL 在比较/聚合/排序/连接中的语义

statement ok
CREATE TABLE nt (id BIGINT PRIMARY KEY, a BIGINT, b TEXT)

statement ok
INSERT INTO nt VALUES (1, 10, 'x'), (2, NULL, 'y'), (3, 30, NULL), (4, NULL, NULL)

# NULL 比较 → NULL → 不匹配
query I
SELECT count(*) FROM nt WHERE a = NULL
----
0

query I
SELECT count(*) FROM nt WHERE a != 10
----
1

# IS NULL / IS NOT NULL
query I
SELECT count(*) FROM nt WHERE a IS NULL
----
2

query I
SELECT count(*) FROM nt WHERE a IS NOT NULL
----
2

# NULL 排序（NULL 放最前/最后——实现定义但需确定性）
query I
SELECT id FROM nt ORDER BY a, id
----
1
3
4
2

query I
SELECT id FROM nt ORDER BY a DESC, id
----
3
1
2
4

# 聚合跳过 NULL
query I
SELECT count(a) FROM nt
----
2

query I
SELECT sum(a) FROM nt
----
40

# COALESCE 替代 NULL
query I
SELECT count(*) FROM nt WHERE coalesce(a, 0) = 0
----
2

# NULL 字符串连接
query T
SELECT b FROM nt WHERE id = 3
----

# IN 包含 NULL
query I
SELECT count(*) FROM nt WHERE a IN (10, NULL)
----
1
