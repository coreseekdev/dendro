# NULL 语义与排序
statement ok
CREATE TABLE n (id BIGINT PRIMARY KEY, x BIGINT)

statement ok
INSERT INTO n VALUES (1, NULL)

statement ok
INSERT INTO n VALUES (2, 5)

statement ok
INSERT INTO n VALUES (3, NULL)

statement ok
INSERT INTO n VALUES (4, 1)

query I
SELECT id FROM n WHERE x IS NULL ORDER BY id
----
1
3

query I
SELECT id FROM n WHERE x IS NOT NULL ORDER BY x
----
4
2

query I
SELECT count(x) FROM n
----
2

query I
SELECT sum(x) FROM n
----
6

query IT
SELECT id, x FROM n ORDER BY x DESC, id
----
1 NULL
3 NULL
2 5
4 1
