# 028: 集合操作（S-4）：UNION / EXCEPT / INTERSECT × DISTINCT / ALL

statement ok
CREATE TABLE s1 (id BIGINT PRIMARY KEY, v BIGINT)

statement ok
CREATE TABLE s2 (id BIGINT PRIMARY KEY, v BIGINT)

statement ok
INSERT INTO s1 VALUES (1, 1), (2, 2), (3, 3), (4, 1)

statement ok
INSERT INTO s2 VALUES (1, 2), (2, 4), (3, 1)

# ===== UNION（默认 DISTINCT 去重）=====
query I
SELECT v FROM s1 UNION SELECT v FROM s2 ORDER BY v
----
1
2
3
4

# UNION ALL 保留重复
query I
SELECT v FROM s1 UNION ALL SELECT v FROM s2 ORDER BY v
----
1
1
1
2
2
3
4

# UNION DISTINCT 等价 UNION
query I
SELECT v FROM s1 UNION DISTINCT SELECT v FROM s2 ORDER BY v
----
1
2
3
4

# 三路链式
query I
SELECT v FROM s1 UNION SELECT v FROM s2 UNION SELECT 99 ORDER BY v
----
1
2
3
4
99

# ===== EXCEPT（默认 DISTINCT 集差+去重）=====
# s1 值集 {1,2,3}，s2 值集 {2,4,1} → 差 {3}
query I
SELECT v FROM s1 EXCEPT SELECT v FROM s2 ORDER BY v
----
3

# EXCEPT ALL 多重集差：s1 [1,1,2,3] 减 s2 [2,4,1] → [1,3]（1 减一次剩一，2 全删）
query I
SELECT v FROM s1 EXCEPT ALL SELECT v FROM s2 ORDER BY v
----
1
3

# ===== INTERSECT（默认 DISTINCT 交集+去重）=====
# s1 ∩ s2 = {1, 2}
query I
SELECT v FROM s1 INTERSECT SELECT v FROM s2 ORDER BY v
----
1
2

# INTERSECT ALL 保留重复交集
query I
SELECT v FROM s1 INTERSECT ALL SELECT v FROM s2 ORDER BY v
----
1
2

# 空交集
statement ok
CREATE TABLE s3 (id BIGINT PRIMARY KEY, v BIGINT)

statement ok
INSERT INTO s3 VALUES (1, 100)

query I
SELECT v FROM s1 INTERSECT SELECT v FROM s3
----

# ===== ORDER BY / LIMIT 在合并后统一应用 =====
query I
SELECT v FROM s1 UNION ALL SELECT v FROM s2 ORDER BY v DESC LIMIT 3
----
4
3
2

# ===== 列数不匹配 → 42601 =====
statement error mismatch
SELECT id, v FROM s1 UNION SELECT v FROM s2

# ===== 跨表异构列 =====
statement ok
CREATE TABLE txt_a (id BIGINT PRIMARY KEY, label TEXT)

statement ok
CREATE TABLE txt_b (id BIGINT PRIMARY KEY, label TEXT)

statement ok
INSERT INTO txt_a VALUES (1, 'alpha'), (2, 'beta')

statement ok
INSERT INTO txt_b VALUES (1, 'beta'), (2, 'gamma')

query T
SELECT label FROM txt_a UNION SELECT label FROM txt_b ORDER BY label
----
alpha
beta
gamma
