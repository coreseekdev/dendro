# 事务深度矩阵（P2-1 续）
statement ok
CREATE TABLE tx (id BIGINT PRIMARY KEY, v TEXT)

statement ok
INSERT INTO tx VALUES (1, 'init')

statement ok
BEGIN

statement ok
INSERT INTO tx VALUES (2, 'committed')

statement ok
COMMIT

query T
SELECT v FROM tx WHERE id = 2
----
committed

statement ok
BEGIN

statement ok
INSERT INTO tx VALUES (3, 'rolled-back')

statement ok
ROLLBACK

query I
SELECT count(*) FROM tx WHERE id = 3
----
0

statement ok
BEGIN

statement ok
INSERT INTO tx VALUES (4, 'own-write')

query T
SELECT v FROM tx WHERE id = 4
----
own-write

statement ok
COMMIT

query T
SELECT v FROM tx WHERE id = 4
----
own-write

statement ok
BEGIN

statement ok
DELETE FROM tx WHERE id = 1

statement ok
COMMIT

query I
SELECT count(*) FROM tx WHERE id = 1
----
0

statement ok
BEGIN

statement ok
UPDATE tx SET v = 'updated' WHERE id = 2

statement ok
ROLLBACK

query T
SELECT v FROM tx WHERE id = 2
----
committed
