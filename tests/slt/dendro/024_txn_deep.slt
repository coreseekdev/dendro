# 事务深度矩阵（P2-1 续）：SAVEPOINT 语义 / 隐式提交 / 多语句事务

statement ok
CREATE TABLE tx (id BIGINT PRIMARY KEY, v TEXT)

statement ok
INSERT INTO tx VALUES (1, 'init')

# 显式事务：INSERT → COMMIT → 可见
statement ok
BEGIN
statement ok
INSERT INTO tx VALUES (2, 'committed')
statement ok
COMMIT

query T
SELECT v FROM tx WHERE id = 2
----
committed

# 显式事务：INSERT → ROLLBACK → 不可见
statement ok
BEGIN
statement ok
INSERT INTO tx VALUES (3, 'rolled-back')
statement ok
ROLLBACK

query I
SELECT count(*) FROM tx WHERE id = 3
----
0

# 事务内读自己的写（read-own-write）
statement ok
BEGIN
statement ok
INSERT INTO tx VALUES (4, 'own-write')
query T
SELECT v FROM tx WHERE id = 4
----
own-write
statement ok
COMMIT

query T
SELECT v FROM tx WHERE id = 4
----
own-write

# 事务内 DELETE → COMMIT → 行消失
statement ok
BEGIN
statement ok
DELETE FROM tx WHERE id = 1
statement ok
COMMIT

query I
SELECT count(*) FROM tx WHERE id = 1
----
0

# 事务内 UPDATE → ROLLBACK → 原值不变
statement ok
BEGIN
statement ok
UPDATE tx SET v = 'updated' WHERE id = 2
statement ok
ROLLBACK

query T
SELECT v FROM tx WHERE id = 2
----
committed

# 事务内多语句混合 DML
statement ok
BEGIN
statement ok
INSERT INTO tx VALUES (5, 'multi-a')
statement ok
UPDATE tx SET v = 'multi-b' WHERE id = 5
statement ok
DELETE FROM tx WHERE id = 1
statement ok
COMMIT

query T
SELECT v FROM tx ORDER BY id
----
multi-b
committed
own-write
