# 优化器 O-1：合取拆分下推 + 账本 #28（join 限定名解析）
# 语义固化（默认 optimize=on）+ EXPLAIN 注记

statement ok
CREATE TABLE o (id BIGINT PRIMARY KEY, cid BIGINT, total BIGINT)

statement ok
CREATE TABLE c (id BIGINT PRIMARY KEY, region TEXT)

statement ok
INSERT INTO o VALUES (1, 1, 100),(2, 1, 250),(3, 2, 50),(4, NULL, 10)

statement ok
INSERT INTO c VALUES (1, 'EU'),(2, 'US')

# 双侧下推的 join 查询（o.total → o 因子；c.region → c 因子）
query I T
SELECT o.id, c.region FROM o JOIN c ON o.cid = c.id WHERE o.total > 60 AND c.region = 'EU' ORDER BY o.id
----
1 EU
2 EU

# #28：两侧同名列 id 的限定读取（o.id ≠ c.id）
query II
SELECT o.id, c.id FROM o JOIN c ON o.cid = c.id WHERE o.total > 60 ORDER BY o.id
----
1 1
2 1

# LEFT JOIN 右侧下推安全（NULL 延展行被 join 后原谓词过滤）
query II
SELECT o.id, c.id FROM o LEFT JOIN c ON o.cid = c.id WHERE c.region = 'EU' ORDER BY o.id
----
1 1
2 1

# 跨表谓词留 join 后（o.total > CAST(c.region ...) 不合法——用恒真跨表比较）
query I
SELECT o.id FROM o JOIN c ON o.cid = c.id WHERE o.total > c.id ORDER BY o.id
----
1
2
3

# 裸列名保守不下推（结果不变）
query I
SELECT o.id FROM o JOIN c ON o.cid = c.id WHERE total > 60 AND region = 'EU' ORDER BY o.id
----
1
2

# 聚合 + join + 下推
query TI
SELECT c.region, count(*), sum(o.total) FROM o JOIN c ON o.cid = c.id WHERE o.total >= 50 GROUP BY c.region ORDER BY c.region
----
EU 2 350
US 1 50

# EXPLAIN：注记行 + 真实逻辑计划块（O-2a——join 形态从 pending 升级）
query T
EXPLAIN SELECT o.id FROM o JOIN c ON o.cid = c.id WHERE o.total > 60 AND c.region = 'EU'
----
optimizer: pushdown 2 conjunct(s) → o(1), c(1)
dendro.ir v1
plan @q0 {
  %t0 = table "o" {cols = [id, cid, total], pk = [0]}
  %s0 = scan %t0
  %f0 = filter %s0, pred "o.total > 60"
  %t1 = table "c" {cols = [id, region], pk = [0]}
  %s1 = scan %t1
  %f1 = filter %s1, pred "c.region = 'EU'"
  %j0 = join inner %f0, %f1 on "o.cid = c.id"
  %p0 = project %j0 {exprs = [o.id], names = ["o.id"]}
  yield %p0
}

# SELECT DISTINCT（R21-17 拒绝 → 实现：投影后 first-seen 去重）
statement ok
CREATE TABLE d (id BIGINT PRIMARY KEY, v TEXT)

statement ok
INSERT INTO d VALUES (1,'v1'),(2,'v2'),(3,'v0'),(4,'v1'),(5,'v0')

query T
SELECT DISTINCT v FROM d ORDER BY v
----
v0
v1
v2

# DISTINCT + WHERE + 多列
query TT
SELECT DISTINCT v, id % 2 FROM d WHERE id <= 3 ORDER BY 1, 2
----
v0 1
v1 1
v2 0

# DISTINCT ≡ GROUP BY（等价性）
query I
SELECT count(*) FROM (SELECT DISTINCT v FROM d) x
----
3

# join reorder（O-4'）：INNER 链贪心重排——多重集等价（行序随 join
# 序变化是设计内行为；这些查询有 ORDER BY 或 count 锁定结果）
statement ok
CREATE TABLE ro (id BIGINT PRIMARY KEY, cid BIGINT, v BIGINT)

statement ok
CREATE TABLE rc (id BIGINT PRIMARY KEY, rid BIGINT)

statement ok
CREATE TABLE rr (id BIGINT PRIMARY KEY, name TEXT)

statement ok
INSERT INTO ro VALUES (1,0,10),(2,1,20),(3,2,30),(4,0,40)

statement ok
INSERT INTO rc VALUES (0,0),(1,1),(2,0)

statement ok
INSERT INTO rr VALUES (0,'r0'),(1,'r1')

query TI
SELECT rr.name, count(*) FROM ro JOIN rc ON ro.cid = rc.id JOIN rr ON rc.rid = rr.id GROUP BY rr.name ORDER BY rr.name
----
r0 3
r1 1

# EXPLAIN 计划块（无段统计 → 不重排，计划=原序；join 查询输出真实
# 计划块——O-2a 起的行为）
query T
EXPLAIN SELECT count(*) FROM ro JOIN rc ON ro.cid = rc.id JOIN rr ON rc.rid = rr.id
----
dendro.ir v1
plan @q0 {
  %t0 = table "ro" {cols = [id, cid, v], pk = [0]}
  %s0 = scan %t0
  %t1 = table "rc" {cols = [id, rid], pk = [0]}
  %s1 = scan %t1
  %j0 = join inner %s0, %s1 on "ro.cid = rc.id"
  %t2 = table "rr" {cols = [id, name], pk = [0]}
  %s2 = scan %t2
  %j1 = join inner %j0, %s2 on "rc.rid = rr.id"
  %a0 = aggregate %j1 {keys = [], aggs = [count(*)]}
  %p0 = project %a0 {exprs = [count(*)], names = ["count(*)"]}
  yield %p0
}
