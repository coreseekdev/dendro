# 基线：DDL 与 CRUD（SPEC 07 §2 矩阵）
hash-threshold 8

statement ok
CREATE TABLE users (id BIGINT PRIMARY KEY, name TEXT NOT NULL, score DOUBLE)

statement ok
INSERT INTO users VALUES (1, 'alice', 90.5)

statement ok
INSERT INTO users VALUES (2, 'bob', 75.0)

statement ok
INSERT INTO users VALUES (3, 'carol', 88.25)

statement error
INSERT INTO users VALUES (1, 'dup', 1.0)

query I
SELECT id FROM users WHERE name = 'bob'
----
2

query IT
SELECT id, name FROM users WHERE score >= 88 ORDER BY score DESC
----
1 alice
3 carol

statement ok
UPDATE users SET score = 95.0 WHERE id = 3

query R
SELECT score FROM users WHERE id = 3
----
95

statement ok
DELETE FROM users WHERE id = 1

query I
SELECT count(*) FROM users
----
2

