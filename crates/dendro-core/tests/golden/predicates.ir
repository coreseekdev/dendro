; corpus: not_in_list
dendro.ir v1
scalar @pred {
  cols = ["id", "v"]
  n_cols = 2
  n_regs = 6
  %r0 = col 0
  %r1 = const i32 0
  %r2 = const i32 1
  %r1 = in.test %r0, %r2
  jump_if_in_found %r1, L11
  %r3 = const i32 2
  %r1 = in.test %r0, %r3
  jump_if_in_found %r1, L11
  %r4 = const i32 3
  %r1 = in.test %r0, %r4
  jump_if_in_found %r1, L11
  %r5 = in.finish %r1 neg
  qual %r5
}
