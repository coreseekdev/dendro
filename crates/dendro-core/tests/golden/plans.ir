; corpus: SELECT DISTINCT cid FROM orders ORDER BY cid LIMIT 2
dendro.ir v1
plan @q0 {
  %t0 = table "orders" {cols = [id, cid, total], pk = [0]}
  %s0 = scan %t0
  %p0 = project %s0 {exprs = [cid], names = ["cid"]}
  %d0 = distinct %p0
  %o0 = sort %d0 {keys = [cid ASC]}
